APP_ENV=development
HTTP_ADDR=127.0.0.1:3000
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://starter:local-development-only@127.0.0.1:5437/starter_development?sslmode=disable
DB_MAX_CONNECTIONS=10

WORKER_CONCURRENCY=4
SHUTDOWN_TIMEOUT=10s
# Set a random token of at least 32 characters to enable GET /metrics.
METRICS_TOKEN=
# Development SMTP is captured locally by Mailpit; nothing is relayed to the internet.
MAIL_ENABLED=true
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM=starter@example.test
MAIL_TLS=none
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=10s
# Enabling AI requires an explicit model and API key. No provider calls happen at boot.
AI_ENABLED=false
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT=30s
AI_MAX_TURNS=3
AI_MAX_OUTPUT_TOKENS=1024
