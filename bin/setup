#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ ! -f .env ]]; then cp .env.example .env; fi
set -a
source .env
set +a
npm ci
go mod download
go -C tools mod download
docker compose up -d --wait postgres mailpit
go run ./cmd/manage migrate
npm run build
echo 'Setup complete. Create your account using bin/manage, then run bin/dev.'
